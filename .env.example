ANALYST_TOKEN=analyst-dev-token
REVIEWER_TOKEN=reviewer-dev-token
KASPARRO_DB=./kasparro.db
KASPARRO_PACK_DIR=.
KASPARRO_RESULTS=./results.json
KASPARRO_LLM_MODE=replay
KASPARRO_LABELS=./eval/labels.json
KASPARRO_EVAL_REPORT=./eval/report.md

# Streamlit frontend default. The sidebar can override it.
KASPARRO_API_URL=http://127.0.0.1:8000

# Candidate's actual active time, written into results.json. Example: 5.5 hours.
KASPARRO_ACTIVE_TIME=

# Real-model adapter (OpenAI-compatible chat completions). Leave blank in replay mode.
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_CALLS=150
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_CHARS=4000
LLM_MAX_TOKENS=500
